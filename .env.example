# Environment Configuration
NODE_ENV=development

# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_API_TIMEOUT=10000

# Data Adapter (local | mock | rest | gql)
DATA_ADAPTER=local

# i18n Configuration
NEXT_PUBLIC_DEFAULT_LOCALE=zh-TW
NEXT_PUBLIC_FALLBACK_LOCALE=en

# Analytics (optional)
# GA4 Web stream Measurement ID (G-*), supplied before next build
# Empty or invalid IDs disable analytics
# Valid IDs enable analytics by default unless a saved preference disables it
# Visitors can opt out through the footer analytics settings
NEXT_PUBLIC_GA_ID=
# Enable only for DebugView verification with a separate test stream
# Debug mode alone does not exclude events from regular reports, rebuild after changes
NEXT_PUBLIC_GA_DEBUG=false

# Feature Flags
NEXT_PUBLIC_ENABLE_ANIMATIONS=true
NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# Docker Configuration
PORT=3000
HOSTNAME=0.0.0.0
